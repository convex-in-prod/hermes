+/// Collect all the native externs used in the module.
+std::unique_ptr<llvh::DenseSet<NativeExtern *>> collectUsedExterns(Module *M) {
+  std::vector<Function *> functions;
+  functions.reserve(M->size());
+  for (auto &F : *M)
