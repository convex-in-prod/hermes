+
+// Keep cache state and the owned miss result out of the ordinary conversion
+// frame. Returning directly above also avoids a string move on bypass paths.
+LLVM_ATTRIBUTE_NOINLINE
+std::string HermesRuntimeImpl::utf8WithReuse(
+    vm::Handle<vm::StringPrimitive> input,
+    vm::ScopedStringReuse &scope) {
+  if (const auto *cached = scope.lookupUTF8(*input))
+    return *cached;
+  auto result = utf8FromStringView(
+      vm::StringPrimitive::createStringView(runtime_, input));
+  scope.storeUTF8(*input, result);
+  // Return an independent buffer: callers such as TextEncoder expose mutable
+  // bytes, while the invocation's cached conversion must remain immutable.
+  return result;
 }
 
