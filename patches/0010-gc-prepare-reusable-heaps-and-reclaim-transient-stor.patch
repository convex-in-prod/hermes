+    if (!data)
+      std::abort();
+    data->symbols[0] = value.unsafeGetRaw();
+    data->symbols[1] = Predefined::getSymbolID(Predefined::length).unsafeGetRaw();
+    data->symbols[2] = Predefined::getSymbolID(Predefined::name).unsafeGetRaw();
+    auto *unit = &data->unit;
+    unit->symbols = data->symbols;
+    unit->num_symbols = 3;
