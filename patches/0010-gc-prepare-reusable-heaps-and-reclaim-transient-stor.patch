+      externalBytes() < preparedExternalBytes_)
+    hermes_fatal("Invalid prepared occupancy boundary");
+  return allocatedBytes() - preparedAllocatedBytes_ +
+      externalBytes() -
+      std::min(preparedExternalBytes_, preparedExternalBytesAtPreparation_);
