+  };
+  checkMaps(first);
+  auto *second = install(addedShapes, 1);
+  ASSERT_TRUE(_sh_prepare_literal_layouts(shr, &result));
+  checkMaps(first);
+  checkMaps(second);
+  // Only the per-unit GC storage roots the classes through this collection.
+  runtime.collect("prepared layouts test");
+  ASSERT_TRUE(_sh_prepare_literal_layouts(shr, &result));
+  checkMaps(first);
+  checkMaps(second);
+}
