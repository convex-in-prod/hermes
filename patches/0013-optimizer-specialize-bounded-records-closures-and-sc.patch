+      equal('x', NaN), equal('x', Infinity), equal('x', 4294967296));
+// CHECK-NEXT: false false false false false false false
+print(surrogate('\uD800\uDC00', 0), surrogate('\uD800\uDC00', 1),
+      surrogate('\uD800', 0), equal('\uD800x', 1), nul('a\0b', 1));
