+              -3.9, -0, 0, 0.9, 1, 2147483647, 2147483648, 4294967295,
+              4294967296, 1e100, Infinity, NaN];
+var digest = 0, comparisons = 0;
+for (var a of values) {
+  for (var b of values) {
