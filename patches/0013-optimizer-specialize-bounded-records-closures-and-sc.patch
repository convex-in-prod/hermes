+    return llvh::None;
+  auto *before = llvh::dyn_cast<FCompareInst>(entry->getCondition());
+  auto *after = llvh::dyn_cast<FCompareInst>(back->getCondition());
+  if (!before || !after ||
+      before->getKind() != ValueKind::FLessThanInstKind ||
+      after->getKind() != ValueKind::FLessThanInstKind ||
+      after->getParent() != body ||
+      before->getRight() != after->getRight())
+    return llvh::None;
+  auto *increment = llvh::dyn_cast<FBinaryMathInst>(after->getLeft());
+  if (!increment || increment->getKind() != ValueKind::FAddInstKind ||
+      increment->getParent() != body)
+    return llvh::None;
+  auto *index = llvh::dyn_cast<PhiInst>(increment->getLeft());
+  auto step = boundedInteger(increment->getRight());
+  if (!index || index->getParent() != body || !step || !*step ||
+      index->getNumEntries() != 2)
+    return llvh::None;
+  for (unsigned i = 0; i < 2; ++i) {
+    auto incoming = index->getEntry(i);
+    if (incoming.second == body ? incoming.first != increment
+        : incoming.second != preheader || incoming.first != before->getLeft())
+      return llvh::None;
+  }
+  ByteLoop loop{body, preheader, back->getFalseDest(), index,
+                before->getLeft(), before->getRight(), nullptr, *step};
+  if (!loop.start->getType().isNumberType() ||
+      !loop.limit->getType().isNumberType() ||
+      !availableBefore(loop.start, entry, dominance) ||
+      !availableBefore(loop.limit, entry, dominance))
+    return llvh::None;
+
+  // Phi assumptions are inductive: each initial value and each backedge value
+  // must be numeric using only the admitted reads and effect-free operations.
+  llvh::SmallPtrSet<Value *, 32> numbers;
+  auto numeric = [&](Value *value) {
+    auto *inst = llvh::dyn_cast<Instruction>(value);
+    return inst && inst->getParent() == body ? numbers.count(value) != 0
+        : value->getType().isNumberType() &&
+            availableBefore(value, entry, dominance);
+  };
+  for (auto &inst : *body) {
+    auto *phi = llvh::dyn_cast<PhiInst>(&inst);
+    if (!phi)
+      break;
+    if (phi->getNumEntries() != 2 || !phi->getType().isNumberType())
+      return llvh::None;
+    bool initial = false, backedge = false;
+    for (unsigned i = 0; i < 2; ++i) {
+      auto incoming = phi->getEntry(i);
+      if (incoming.second == preheader) {
+        if (!incoming.first->getType().isNumberType() ||
+            !availableBefore(incoming.first, entry, dominance))
+          return llvh::None;
+        initial = true;
+      } else if (incoming.second == body) {
+        backedge = true;
+      }
+    }
+    if (!initial || !backedge)
+      return llvh::None;
+    numbers.insert(phi);
+  }
+
+  for (auto &inst : *body) {
+    // Every escaping value needs an edge-specific merge for the cloned loop.
+    for (auto *user : inst.getUsers()) {
+      if (user->getParent() == body)
+        continue;
+      auto *phi = llvh::dyn_cast<PhiInst>(user);
+      if (!phi || phi->getParent() != loop.exit)
+        return llvh::None;
+      for (unsigned i = 0; i < phi->getNumEntries(); ++i) {
+        auto incoming = phi->getEntry(i);
+        if (incoming.first == &inst && incoming.second != body)
+          return llvh::None;
+      }
+    }
+    if (llvh::isa<PhiInst>(&inst) || &inst == back)
+      continue;
+    if (&inst == after) {
+      if (!numeric(after->getLeft()) || !numeric(after->getRight()))
+        return llvh::None;
+      continue;
+    }
+    if (auto *load = llvh::dyn_cast<LoadPropertyInst>(&inst)) {
+      if (!availableBefore(load->getObject(), entry, dominance) ||
+          (loop.receiver && loop.receiver != load->getObject()))
+        return llvh::None;
+      unsigned offset = 0;
+      if (load->getProperty() != index) {
+        auto *add = llvh::dyn_cast<FBinaryMathInst>(load->getProperty());
+        if (!add || add->getKind() != ValueKind::FAddInstKind ||
+            add->getParent() != body || add->getLeft() != index)
+          return llvh::None;
+        auto literal = boundedInteger(add->getRight());
+        if (!literal)
+          return llvh::None;
+        offset = *literal;
+      }
+      loop.receiver = load->getObject();
+      loop.maxOffset = std::max(loop.maxOffset, offset);
+    } else if (auto *call = llvh::dyn_cast<CallBuiltinInst>(&inst)) {
+      if (call->getBuiltinIndex() != BuiltinMethod::Math_imul ||
+          call->getNumArguments() != 3 ||
+          !numeric(call->getArgument(1)) || !numeric(call->getArgument(2)))
+        return llvh::None;
+    } else {
+      // Output Number alone is insufficient: bitwise operations and AsUint32
+      // can invoke user coercions when any input is not proven numeric.
+      switch (inst.getKind()) {
+        case ValueKind::FAddInstKind:
+        case ValueKind::FSubtractInstKind:
+        case ValueKind::FMultiplyInstKind:
+        case ValueKind::FDivideInstKind:
+        case ValueKind::FModuloInstKind:
+        case ValueKind::FNegateKind:
+        case ValueKind::AsUint32InstKind:
+        case ValueKind::AsInt32InstKind:
+        case ValueKind::BinaryAndInstKind:
+        case ValueKind::BinaryOrInstKind:
+        case ValueKind::BinaryXorInstKind:
+        case ValueKind::BinaryLeftShiftInstKind:
+        case ValueKind::BinaryRightShiftInstKind:
+        case ValueKind::BinaryUnsignedRightShiftInstKind:
+          break;
+        default:
+          return llvh::None;
+      }
+      for (unsigned i = 0; i < inst.getNumOperands(); ++i)
+        if (!numeric(inst.getOperand(i)))
+          return llvh::None;
+    }
+    numbers.insert(&inst);
+  }
+  if (!loop.receiver)
+    return llvh::None;
+  for (auto &inst : *body) {
+    auto *phi = llvh::dyn_cast<PhiInst>(&inst);
+    if (!phi)
+      break;
+    for (unsigned i = 0; i < 2; ++i)
+      if (!numeric(phi->getEntry(i).first))
+        return llvh::None;
+  }
+  return loop;
+}
+
+static void specialize(Function *function, const ByteLoop &loop) {
+  IRBuilder builder(function);
+  auto &context = function->getContext();
+  auto &native = context.getNativeContext();
+  auto *probeSignature = native.getSignature(
+      NativeCType::c_bool,
+      {NativeCType::ptr, NativeCType::c_hermes_value, NativeCType::c_double,
+       NativeCType::c_double, NativeCType::c_uint, NativeCType::c_uint});
+  auto *probe = native.getExtern(
+      context.getStringTable().getString("_sh_can_read_byte_array_loop"),
+      probeSignature, {}, true, nullptr);
+  auto *readSignature = native.getSignature(
+      NativeCType::c_uchar,
+      {NativeCType::ptr, NativeCType::c_hermes_value, NativeCType::c_double});
+  auto *read = native.getExtern(
+      context.getStringTable().getString("_sh_read_byte_array_element"),
+      readSignature, {}, true, nullptr);
+  auto *guard = builder.createBasicBlock(function);
+  auto *fast = builder.createBasicBlock(function);
+  builder.setInsertionBlock(guard);
+  builder.setLocation(loop.body->getTerminator()->getLocation());
+  auto *runtime = builder.createGetNativeRuntimeInst();
+  auto *condition = builder.createNativeCallInst(
+      Type::createNumber(), builder.getLiteralNativeExtern(probe), probeSignature,
+      {runtime, loop.receiver, loop.start, loop.limit,
+       builder.getLiteralNumber(loop.step),
+       builder.getLiteralNumber(loop.maxOffset)});
+  builder.createCondBranchInst(condition, fast, loop.body);
+
+  llvh::DenseMap<Value *, Value *> copies;
+  copies[loop.body] = fast;
+  copies[loop.preheader] = guard;
+  auto mapped = [&](Value *value) -> Value * {
+    auto found = copies.find(value);
+    return found == copies.end() ? value : found->second;
+  };
+  builder.setInsertionBlock(fast);
+  // Create every phi before translating backedges or mutually dependent phis.
+  for (auto &inst : *loop.body) {
+    auto *phi = llvh::dyn_cast<PhiInst>(&inst);
+    if (!phi)
+      break;
+    auto *copy = builder.createPhiInst();
+    copy->setType(phi->getType());
+    copies[phi] = copy;
+  }
+  for (auto &inst : *loop.body) {
+    if (llvh::isa<PhiInst>(&inst))
+      continue;
+    builder.setLocation(inst.getLocation());
+    if (auto *load = llvh::dyn_cast<LoadPropertyInst>(&inst)) {
+      copies[load] = builder.createNativeCallInst(
+          Type::createNumber(), builder.getLiteralNativeExtern(read),
+          readSignature, {runtime, loop.receiver, mapped(load->getProperty())});
+    } else {
+      llvh::SmallVector<Value *, 8> operands;
+      for (unsigned i = 0; i < inst.getNumOperands(); ++i)
+        operands.push_back(mapped(inst.getOperand(i)));
+      copies[&inst] = builder.cloneInst(&inst, operands);
+    }
+  }
+  for (auto &inst : *loop.body) {
+    auto *phi = llvh::dyn_cast<PhiInst>(&inst);
+    if (!phi)
+      break;
+    auto *copy = llvh::cast<PhiInst>(copies[phi]);
+    for (unsigned i = 0; i < 2; ++i) {
+      auto incoming = phi->getEntry(i);
+      copy->addEntry(mapped(incoming.first),
+                     llvh::cast<BasicBlock>(mapped(incoming.second)));
+      if (incoming.second == loop.preheader)
+        phi->updateEntry(i, incoming.first, guard);
+    }
+  }
+  // Include invariant exit values too: all exit phis must cover the new edge.
+  for (auto &inst : *loop.exit) {
+    auto *phi = llvh::dyn_cast<PhiInst>(&inst);
+    if (!phi)
+      break;
+    unsigned count = phi->getNumEntries();
+    for (unsigned i = 0; i < count; ++i) {
+      auto incoming = phi->getEntry(i);
+      if (incoming.second == loop.body)
+        phi->addEntry(mapped(incoming.first), fast);
+    }
+  }
+  loop.preheader->getTerminator()->setOperand(guard, CondBranchInst::TrueBlockIdx);
+  ++NumByteArrayLoops;
+}
+
+static bool run(Function *function) {
+  const auto &settings = function->getContext().getOptimizationSettings();
+  if (!settings.staticHermesInlining || !settings.guardedByteArrayLoops ||
+      functionHasTryCatch(function))
+    return false;
+  unsigned count = 0;
+  for (auto &block : *function) {
+    count += block.size();
+    if (count > 4096)
+      return false;
+  }
+  DominanceInfo dominance(function);
+  llvh::SmallVector<ByteLoop, 4> loops;
+  for (auto &block : *function) {
+    auto loop = findLoop(&block, dominance);
+    if (loop)
+      loops.push_back(*loop);
+    if (loops.size() == 4)
+      break;
+  }
+  for (const auto &loop : loops)
+    specialize(function, loop);
+  return !loops.empty();
+}
+
+} // namespace
+
+Pass *createGuardedByteArrayLoops() {
+  class ThisPass final : public FunctionPass {
+   public:
+    ThisPass() : FunctionPass("GuardedByteArrayLoops") {}
+    bool runOnFunction(Function *function) override {
+      return run(function);
+    }
+  };
+  return new ThisPass();
+}
+
+} // namespace hermes
diff --git a/lib/Optimizer/Scalar/GuardedDataPropertyDefinitions.cpp b/lib/Optimizer/Scalar/GuardedDataPropertyDefinitions.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a997eaaba30727f567253ebb2291395deece1739
--- /dev/null
+++ b/lib/Optimizer/Scalar/GuardedDataPropertyDefinitions.cpp
@@ -0,0 +1,207 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#include "hermes/AST/NativeContext.h"
+#include "hermes/IR/Analysis.h"
+#include "hermes/IR/CFG.h"
+#include "hermes/IR/IRBuilder.h"
+#include "hermes/Optimizer/PassManager/Pass.h"
+#include "hermes/Optimizer/Scalar/Utils.h"
+#include "hermes/Support/Statistic.h"
+
+#define DEBUG_TYPE "guarded-data-property-definitions"
+
+STATISTIC(NumGuardedDefinitions, "Data-property construction sequences fused");
+
+namespace hermes {
+namespace {
+
+struct Definition {
+  BinaryOperatorInst *has;
+  LoadFrameInst *callee;
+  StorePropertyStrictInst *store;
+  BasicBlock *join;
+};
+
+/// Recognize a complete, unused-result definition, not a named helper:
+/// if (key in receiver) define(receiver, key, {value, ...true flags});
+/// else receiver[key] = value;
+/// Strict assignment is required: adding to a nonextensible object must throw
+/// on either path. The runtime guard proves that `in` has no observable effects.
+static OptValue<Definition> findDefinition(
+    BinaryOperatorInst *has,
+    const DominanceInfo &dominance) {
+  if (has->getKind() != ValueKind::BinaryInInstKind || !has->hasOneUser() ||
+      !llvh::isa<LiteralString>(has->getLeftHandSide()))
+    return llvh::None;
+  auto *branch = llvh::dyn_cast<CondBranchInst>(*has->getUsers().begin());
+  if (!branch || branch->getParent() != has->getParent() ||
+      branch->getCondition() != has ||
+      std::next(has->getIterator()) != branch->getIterator())
+    return llvh::None;
+  auto *present = branch->getTrueDest();
+  auto *absent = branch->getFalseDest();
+  if (present == absent || pred_count(present) != 1 || pred_count(absent) != 1 ||
+      present->size() > 5 || absent->size() != 2)
+    return llvh::None;
+  auto *presentEnd = llvh::dyn_cast<BranchInst>(present->getTerminator());
+  auto *absentEnd = llvh::dyn_cast<BranchInst>(absent->getTerminator());
+  auto *store = llvh::dyn_cast<StorePropertyStrictInst>(&absent->front());
+  if (!presentEnd || !absentEnd || !store ||
+      presentEnd->getBranchDest() != absentEnd->getBranchDest() ||
+      store->getObject() != has->getRightHandSide() ||
+      store->getProperty() != has->getLeftHandSide())
+    return llvh::None;
+  auto *join = presentEnd->getBranchDest();
+  // A result phi may distinguish the call's receiver from the assigned value.
+  // Do not invent that result or bypass other edge-dependent values.
+  if (llvh::isa<PhiInst>(&join->front()))
+    return llvh::None;
+
+  LoadFrameInst *callee = nullptr;
+  AllocObjectLiteralInst *descriptor = nullptr;
+  CallInst *call = nullptr;
+  PrStoreInst *valueStore = nullptr;
+  for (auto &inst : *present) {
+    if (auto *load = llvh::dyn_cast<LoadFrameInst>(&inst)) {
+      if (callee || descriptor || call)
+        return llvh::None;
+      callee = load;
+    } else if (auto *alloc = llvh::dyn_cast<AllocObjectLiteralInst>(&inst)) {
+      if (descriptor || call)
+        return llvh::None;
+      descriptor = alloc;
+    } else if (auto *slot = llvh::dyn_cast<PrStoreInst>(&inst)) {
+      if (!descriptor || valueStore || call || slot->getObject() != descriptor)
+        return llvh::None;
+      valueStore = slot;
+    } else if (auto *invoke = llvh::dyn_cast<CallInst>(&inst)) {
+      if (!descriptor || call)
+        return llvh::None;
+      call = invoke;
+    } else if (&inst != presentEnd) {
+      return llvh::None;
+    }
+  }
+  if (!callee || !descriptor || !call || call->hasUsers() ||
+      call->getNumArguments() != 4 || call->getCallee() != callee ||
+      !call->getNewTarget()->getType().isUndefinedType() ||
+      call->getArgument(1) != store->getObject() ||
+      call->getArgument(2) != store->getProperty() ||
+      call->getArgument(3) != descriptor ||
+      descriptor->getKeyValuePairCount() != 4 ||
+      !llvh::isa<EmptySentinel>(descriptor->getParentObject()))
+    return llvh::None;
+  if (valueStore &&
+      (valueStore->getPropIndex() >= 4 ||
+       valueStore->getPropName() != descriptor->getKey(valueStore->getPropIndex())))
+    return llvh::None;
+  auto *scope = llvh::dyn_cast<Instruction>(callee->getScope());
+  if (!scope || !dominance.properlyDominates(scope, has))
+    return llvh::None;
+  if (auto *value = llvh::dyn_cast<Instruction>(store->getStoredValue()))
+    if (!dominance.properlyDominates(value, has))
+      return llvh::None;
+  unsigned flags = 0;
+  Value *storedValue = nullptr;
+  for (unsigned i = 0; i < 4; ++i) {
+    auto *key = llvh::dyn_cast<LiteralString>(descriptor->getKey(i));
+    if (!key)
+      return llvh::None;
+    const auto name = key->getValue().str();
+    unsigned bit;
+    if (name == "value") {
+      bit = 8;
+      storedValue = descriptor->getValue(i);
+      if (valueStore && valueStore->getPropIndex() == i)
+        storedValue = valueStore->getStoredValue();
+    } else {
+      bit = name == "enumerable" ? 1 : name == "configurable" ? 2
+          : name == "writable" ? 4 : 0;
+      auto *value = llvh::dyn_cast<LiteralBool>(descriptor->getValue(i));
+      if (!bit || !value || !value->getValue() ||
+          (valueStore && valueStore->getPropIndex() == i))
+        return llvh::None;
+    }
+    if (flags & bit)
+      return llvh::None;
+    flags |= bit;
+  }
+  if (flags != 15 || storedValue != store->getStoredValue())
+    return llvh::None;
+  for (auto *user : descriptor->getUsers())
+    if (user != call && user != valueStore)
+      return llvh::None;
+  return Definition{has, callee, store, join};
+}
+
+static bool run(Function *function) {
+  const auto &settings = function->getContext().getOptimizationSettings();
+  // The descriptor's absent `get`/`set` fields must stay absent on its prototype.
+  if (!settings.staticHermesInlining ||
+      !settings.guardedDataPropertyDefinitions ||
+      !settings.staticObjectPrototype || functionHasTryCatch(function))
+    return false;
+  DominanceInfo dominance(function);
+  llvh::SmallVector<Definition, 8> definitions;
+  for (auto &block : *function)
+    for (auto &inst : block)
+      if (auto *has = llvh::dyn_cast<BinaryOperatorInst>(&inst)) {
+        auto definition = findDefinition(has, dominance);
+        if (definition && definitions.size() < 16)
+          definitions.push_back(*definition);
+      }
+  if (definitions.empty())
+    return false;
+  IRBuilder builder(function);
+  auto &context = function->getContext();
+  auto &native = context.getNativeContext();
+  auto *signature = native.getSignature(
+      NativeCType::c_bool,
+      {NativeCType::ptr, NativeCType::c_hermes_value, NativeCType::c_hermes_value});
+  auto *probe = native.getExtern(
+      context.getStringTable().getString("_sh_ljs_can_define_data_property"),
+      signature, {}, true, nullptr);
+  for (auto definition : definitions) {
+    auto *before = definition.has->getParent();
+    auto *slow = splitBasicBlock(before, definition.has->getIterator());
+    auto *fast = builder.createBasicBlock(function);
+    builder.setInsertionBlock(before);
+    builder.setLocation(definition.has->getLocation());
+    // A speculative frame read has no effects. Keep the original read in the
+    // fallback: an observable `in` trap may replace the captured function.
+    auto *callee = builder.createLoadFrameInst(
+        definition.callee->getScope(), definition.callee->getLoadVariable());
+    auto *guard = builder.createNativeCallInst(
+        Type::createNumber(), builder.getLiteralNativeExtern(probe), signature,
+        {builder.createGetNativeRuntimeInst(), callee,
+         definition.store->getObject()});
+    builder.createCondBranchInst(guard, fast, slow);
+    builder.setInsertionBlock(fast);
+    builder.createDefineOwnPropertyInst(
+        definition.store->getStoredValue(), definition.store->getObject(),
+        definition.store->getProperty(), IRBuilder::PropEnumerable::Yes);
+    builder.createBranchInst(definition.join);
+    ++NumGuardedDefinitions;
+  }
+  return true;
+}
+
+} // namespace
+
+Pass *createGuardedDataPropertyDefinitions() {
+  class ThisPass final : public FunctionPass {
+   public:
+    ThisPass() : FunctionPass("GuardedDataPropertyDefinitions") {}
+    bool runOnFunction(Function *function) override {
+      return run(function);
+    }
+  };
+  return new ThisPass();
+}
+
+} // namespace hermes
diff --git a/lib/Optimizer/Scalar/GuardedMethodCalls.cpp b/lib/Optimizer/Scalar/GuardedMethodCalls.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7c13c82e7b40a1731e712f40fdbc36889d39e7f5
--- /dev/null
+++ b/lib/Optimizer/Scalar/GuardedMethodCalls.cpp
@@ -0,0 +1,219 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#include "hermes/IR/IRBuilder.h"
+#include "hermes/Optimizer/PassManager/Pass.h"
+#include "hermes/Optimizer/Scalar/Utils.h"
+
+#include "llvh/ADT/DenseMap.h"
+
+namespace hermes {
+namespace {
+
+struct Method {
+  CreateFunctionInst *closure;
+  CreateScopeInst *scope;
+  Value *owner;
+  LiteralString *key;
+  Variable *capture = nullptr;
+};
+
+// Scope creation in the entry block must precede a call in that same block.
+// Requiring entry scopes also excludes per-iteration/block environments whose
+// creation does not dominate every potential call in the function.
+bool precedesCall(Instruction *scope, CallInst *call) {
+  if (scope->getParent() != &scope->getFunction()->front())
+    return false;
+  if (scope->getParent() != call->getParent())
+    return true;
+  for (auto &inst : *scope->getParent()) {
+    if (&inst == scope)
+      return true;
+    if (&inst == call)
+      return false;
+  }
+  llvm_unreachable("Call must occur in its block");
+}
+
+Instruction *accessibleScope(Method &method, CallInst *call) {
+  if (method.scope->getFunction() == call->getFunction())
+    return precedesCall(method.scope, call) ? method.scope : nullptr;
+  for (auto *user : call->getFunction()->getParentScopeParam()->getUsers()) {
+    auto *parent = llvh::dyn_cast<GetParentScopeInst>(user);
+    if (!parent || !precedesCall(parent, call))
+      continue;
+    for (auto *scope = parent->getVariableScope(); scope;
+         scope = scope->getParentScope())
+      if (scope == method.scope->getVariableScope())
+        return parent;
+  }
+  return nullptr;
+}
+
+bool run(Module *M) {
+  if (!M->getContext().getOptimizationSettings().guardedMethodCalls)
+    return false;
+
+  llvh::SmallVector<Method, 32> methods;
+  llvh::DenseMap<Function *, Value *> owners;
+  llvh::DenseMap<LiteralString *, llvh::SmallVector<unsigned, 2>> byKey;
+  for (auto &F : *M) {
+    for (auto &BB : F) {
+      for (auto &inst : BB) {
+        auto *store = llvh::dyn_cast<DefineOwnPropertyInst>(&inst);
+        if (!store)
+          continue;
+        auto *closure = llvh::dyn_cast<CreateFunctionInst>(store->getStoredValue());
+        auto *key = llvh::dyn_cast<LiteralString>(store->getProperty());
+        if (!closure || !key ||
+            closure->getFunctionCode()->getDefinitionKind() !=
+                Function::DefinitionKind::ES6Method)
+          continue;
+        auto *scope = llvh::dyn_cast<CreateScopeInst>(closure->getScope());
+        if (!scope || scope->getParent() != &F.front())
+          continue;
+        auto *target = closure->getFunctionCode();
+        owners[target] = store->getObject();
+        unsigned size = 0;
+        for (auto &block : *target)
+          size += block.size();
+        if (size > 96 || target->size() > 24)
+          continue;
+        byKey[key].push_back(methods.size());
+        methods.push_back({closure, scope, store->getObject(), key});
+      }
+    }
+  }
+
+  struct Site {
+    CallInst *call;
+    unsigned method;
+    Instruction *scope;
+  };
+  llvh::SmallVector<Site, 64> sites;
+  for (auto &F : *M) {
+    unsigned functionSites = 0;
+    for (auto &BB : F) {
+      for (auto &inst : BB) {
+        auto *call = llvh::dyn_cast<CallInst>(&inst);
+        if (!call || !call->getNewTarget()->getType().isUndefinedType() ||
+            !llvh::isa<EmptySentinel>(call->getTarget()) ||
+            functionSites >= 16 || sites.size() >= 512)
+          continue;
+        auto *load = llvh::dyn_cast<LoadPropertyInst>(call->getCallee());
+        auto *key = load ? llvh::dyn_cast<LiteralString>(load->getProperty()) : nullptr;
+        if (!key || !byKey.count(key))
+          continue;
+        llvh::SmallVector<Site, 4> eligible;
+        for (auto index : byKey[key]) {
+          auto &method = methods[index];
+          if (method.closure->getFunctionCode() == &F)
+            continue;
+          if (auto *scope = accessibleScope(method, call))
+            eligible.push_back({call, index, scope});
+        }
+        // A member's calls on `this` preferentially use its own class's method.
+        // Identity is still checked: borrowed methods, shadowing and prototype
+        // replacement must use the original indirect call when they differ.
+        auto *receiver = llvh::dyn_cast<LoadParamInst>(load->getObject());
+        if (receiver && receiver->getParam() == F.getJSDynamicParam(0) &&
+            owners.count(&F)) {
+          llvh::SmallVector<Site, 4> sameOwner;
+          for (auto &site : eligible)
+            if (methods[site.method].owner == owners[&F])
+              sameOwner.push_back(site);
+          if (!sameOwner.empty())
+            eligible = std::move(sameOwner);
+        }
+        // Do not build a chain of speculative guards for ambiguous names.
+        if (eligible.size() != 1)
+          continue;
+        sites.push_back(eligible.front());
+        ++functionSites;
+      }
+    }
+  }
+
+  IRBuilder builder{M};
+  for (auto &site : sites) {
+    auto &method = methods[site.method];
+    if (!method.capture) {
+      method.capture = builder.createVariable(
+          method.scope->getVariableScope(), method.key->getValue(),
+          Type::createAnyType(), true);
+      builder.setLocation(method.closure->getLocation());
+      builder.setInsertionPointAfter(method.scope);
+      builder.createStoreFrameInst(
+          method.scope, builder.getLiteralUndefined(), method.capture);
+      builder.setInsertionPointAfter(method.closure);
+      builder.createStoreFrameInst(method.scope, method.closure, method.capture);
+    }
+
+    auto *call = site.call;
+    auto *F = call->getFunction();
+    auto *before = call->getParent();
+    auto *join = splitBasicBlock(before, call->getIterator());
+    auto *identity = builder.createBasicBlock(F);
+    auto *fast = builder.createBasicBlock(F);
+    auto *slow = builder.createBasicBlock(F);
+    builder.setInsertionBlock(before);
+    builder.setLocation(call->getLocation());
+    auto *scope = site.scope;
+    auto *sourceScope = llvh::cast<BaseScopeInst>(scope)->getVariableScope();
+    if (sourceScope != method.capture->getParent())
+      scope = builder.createResolveScopeInst(
+          method.capture->getParent(), sourceScope, scope);
+    auto *expected = builder.createLoadFrameInst(scope, method.capture);
+    auto *initialized = builder.createBinaryOperatorInst(
+        expected, builder.getLiteralUndefined(),
+        ValueKind::BinaryStrictlyNotEqualInstKind);
+    builder.createCondBranchInst(initialized, identity, slow);
+    builder.setInsertionBlock(identity);
+    auto *matches = builder.createBinaryOperatorInst(
+        call->getCallee(), expected, ValueKind::BinaryStrictlyEqualInstKind);
+    builder.createCondBranchInst(matches, fast, slow);
+
+    builder.setInsertionBlock(fast);
+    llvh::SmallVector<Value *, 8> args;
+    for (unsigned i = 1; i < call->getNumArguments(); ++i)
+      args.push_back(call->getArgument(i));
+    auto *direct = builder.createCallInst(
+        expected, builder.getLiteralUndefined(), call->getThis(), args);
+    direct->setTarget(method.closure->getFunctionCode());
+    // This private slot holds only undefined or this method's closure. The
+    // initialization guard therefore proves closure identity for direct-call
+    // emission as well as inlining. Derive the environment from that closure,
+    // never from another factory invocation or from the receiver's class.
+    direct->setCalleeIsAlwaysClosure(builder.getLiteralBool(true));
+    builder.createBranchInst(join);
+
+    builder.setInsertionBlock(slow);
+    auto *branch = builder.createBranchInst(join);
+    call->moveBefore(branch);
+    builder.setInsertionPoint(&join->front());
+    auto *result = builder.createPhiInst();
+    call->replaceAllUsesWith(result);
+    result->addEntry(direct, fast);
+    result->addEntry(call, slow);
+  }
+  return !sites.empty();
+}
+
+} // namespace
+
+Pass *createGuardedMethodCalls() {
+  class ThisPass : public ModulePass {
+   public:
+    ThisPass() : ModulePass("GuardedMethodCalls") {}
+    bool runOnModule(Module *M) override {
+      return run(M);
+    }
+  };
+  return new ThisPass();
+}
+
+} // namespace hermes
