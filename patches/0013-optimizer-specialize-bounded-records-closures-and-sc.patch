+/**
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+// Repeated callsites in one try region must not expand without a caller budget.
+// RUN: python3 -c "from pathlib import Path; calls=''.join('sum += read({left: input | 0, right: %d});\n' % i for i in range(80)); Path(r'%t.js').write_text('(function () { \\\"use strict\\\"; function read(value) { var sum = value.left + value.right; return sum > 0 ? sum : 0; } function withManyReaders(input) { \\\"noinline\\\"; var sum = 0; try {\n' + calls + '\n} catch (e) { return -1; } return sum; } print(withManyReaders(1)); print(withManyReaders({valueOf() {throw 1;}})); })();')"
+// RUN: %shermes -O -exec %t.js | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -dump-ir -Xdump-functions=withManyReaders %t.js | %FileCheck --check-prefix=IR %s
+
+// CHECK: 3240
+// CHECK-NEXT: -1
+// IR-LABEL: function withManyReaders(
+// IR: CallInst {{.*}} %read(): functionCode
diff --git a/test/shermes/inline-object-reader-try.js b/test/shermes/inline-object-reader-try.js
new file mode 100644
index 0000000000000000000000000000000000000000..7a059ff20c9b43d5a245c22530c01f74692925af
--- /dev/null
+++ b/test/shermes/inline-object-reader-try.js
@@ -0,0 +1,86 @@
+/**
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+// RUN: %shermes -O -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -Xsmall-c -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fno-inline -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -dump-ir -Xdump-functions=withCatch %s | %FileCheck --check-prefix=IR %s
+
+(function () {
+  'use strict';
+  function assert(value) {
+    if (!value) throw new Error('inline object reader contract');
+  }
+  function read(value) {
+    var sum = value.left + value.right;
+    return sum > 0 ? sum : 0;
+  }
+  function withCatch(left, right) {
+    'noinline';
+    try { return read({left: left | 0, right: right | 0}); }
+    catch (e) { return -1; }
+  }
+  assert(withCatch(3, 5) === 8);
+  assert(withCatch(-3, -5) === 0);
+  assert(withCatch({valueOf() { throw 1; }}, 5) === -1);
+
+  var marker = {value: 19};
+  var finallyCount = 0;
+  function readOrThrow(value) {
+    var sum = value.left + value.right;
+    gc();
+    if (value.fail) throw value.error;
+    return sum;
+  }
+  function withFinally(fail, error) {
+    'noinline';
+    var retained = {value: 23};
+    try {
+      return readOrThrow({left: 3, right: 5, fail: fail, error: error});
+    } catch (e) {
+      gc();
+      assert(retained.value === 23);
+      return e;
+    } finally {
+      gc();
+      assert(retained.value === 23);
+      ++finallyCount;
+    }
+  }
+  assert(withFinally(false, marker) === 8);
+  assert(withFinally(true, marker) === marker);
+  assert(withFinally(true, undefined) === undefined);
+  assert(withFinally(true, 0) === 0);
+  assert(finallyCount === 4);
+
+  // Object promotion must still reject a value exposed to an unknown callee.
+  function escapingReader(value, consumer) {
+    consumer(value);
+    return value.left + value.right;
+  }
+  function escapingTry(consumer) {
+    'noinline';
+    try { return escapingReader({left: 3, right: 5}, consumer); }
+    catch (e) { return e; }
+  }
+  var escaped;
+  assert(escapingTry(function (value) { escaped = value; gc(); value.left = 9; }) === 14);
+  assert(escaped.left === 9 && escaped.right === 5);
+  assert(escapingTry(function () { throw marker; }) === marker);
+  print('inline object readers in try passed');
+})();
+
+// CHECK: inline object readers in try passed
+// IR-LABEL: function withCatch(
+// IR-NOT: AllocObject
+// IR-NOT: LoadPropertyInst
+// IR-NOT: CallInst
+// IR: FAddInst
+// IR-NOT: AllocObject
+// IR-NOT: LoadPropertyInst
+// IR-NOT: CallInst
+// IR: function_end
diff --git a/test/shermes/inline-record-returns.js b/test/shermes/inline-record-returns.js
new file mode 100644
index 0000000000000000000000000000000000000000..c8f39db2e97cfddd399bb4fc142d64675de73a13
--- /dev/null
+++ b/test/shermes/inline-record-returns.js
@@ -0,0 +1,134 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+// RUN: %shermes -O -finline-record-returns -verify-ir -exec %s | %FileCheck %s
+// RUN: %shermes -O -verify-ir -exec %s | %FileCheck %s
+// RUN: %shermes -O -finline-record-returns -fno-inline -verify-ir -exec %s | %FileCheck %s
+// RUN: %shermes -O -finline-record-returns -Xsmall-c -verify-ir -exec %s | %FileCheck %s
+// RUN: %shermes -O -finline-record-returns -verify-ir -dump-ir -Xdump-functions=read %s | %FileCheck --check-prefix=IR %s
+// RUN: %shermes -O -finline-record-returns -verify-ir -dump-ir -Xdump-functions=plainRead %s | %FileCheck --check-prefix=NOHANDLER %s
+
+(function () {
+  'use strict';
+  let effects = [];
+
+  function produce(items, mode) {
+    let total = 0;
+    let count = 0;
+    let last = null;
+    try {
+      for (const item of items) {
+        total += +item;
+        last = {count: ++count};
+        if (mode === 'break') break;
+        if (mode === 'throw' || mode === 'rethrow') throw new Error('body');
+      }
+    } catch (error) {
+      effects.push('inner:' + error.message);
+      if (mode === 'rethrow') throw error;
+      total = -count;
+    } finally {
+      effects.push('finally');
+      if (mode === 'finally') throw new Error('cleanup');
+      gc();
+    }
+    return {total, count, last};
+  }
+
+  function read(items, mode) {
+    'noinline';
+    try {
+      const result = produce(items, mode);
+      return result.total * 100 + result.count * 10 +
+        (result.last === null ? 0 : result.last.count);
+    } catch (error) {
+      effects.push('outer:' + error.message);
+      return 900;
+    }
+  }
+
+  function escape(items) {
+    'noinline';
+    return produce(items, 'normal');
+  }
+
+  function plainRead(items) {
+    'noinline';
+    const result = produce(items, 'normal');
+    return result.total + result.count;
+  }
+
+  function readInherited(items) {
+    'noinline';
+    return produce(items, 'normal').inherited;
+  }
+
+  function iterable(closeThrows) {
+    return {
+      [Symbol.iterator]() {
+        let value = 0;
+        return {
+          next() { return {done: value === 3, value: ++value}; },
+          return() {
+            effects.push('close');
+            if (closeThrows) throw new Error('close');
+            return {done: true};
+          }
+        };
+      }
+    };
+  }
+
+  function check(actual, expected) {
+    if (actual !== expected) throw new Error('unexpected result');
+  }
+
+  for (const [mode, expected, trace] of [
+    ['normal', 633, 'finally'],
+    ['break', 111, 'close,finally'],
+    ['throw', -89, 'close,inner:body,finally'],
+    ['rethrow', 900, 'close,inner:body,finally,outer:body'],
+    ['finally', 900, 'finally,outer:cleanup']
+  ]) {
+    effects = [];
+    check(read(iterable(false), mode), expected);
+    check(effects.join(','), trace);
+  }
+  effects = [];
+  check(read(iterable(true), 'break'), -89);
+  check(effects.join(','), 'close,inner:close,finally');
+  effects = [];
+  check(read(iterable(true), 'throw'), -89);
+  check(effects.join(','), 'close,inner:body,finally');
+  effects = [];
+  check(read([{valueOf() { throw new Error('coercion'); }}], 'normal'), 0);
+  check(effects.join(','), 'inner:coercion,finally');
+  const first = escape([1]);
+  const second = escape([1]);
+  check(first === second, false);
+  check(first.last === second.last, false);
+  check(plainRead([1, 2]), 5);
+  Object.defineProperty(Object.prototype, 'inherited', {
+    configurable: true,
+    get() { return this.count + 40; }
+  });
+  check(readInherited([1, 2]), 42);
+  delete Object.prototype.inherited;
+  print('record return inlining passed');
+})();
+
+// CHECK: record return inlining passed
+// IR-LABEL: function read(
+// IR-NOT: %produce(): functionCode
+// IR-NOT: AllocObjectLiteralInst {{.*}}"total": string
+// IR-NOT: LoadPropertyInst {{.*}}"total": string
+// IR: function_end
+// NOHANDLER-LABEL: function plainRead(
+// NOHANDLER-NOT: TryStartInst
+// NOHANDLER: CallInst {{.*}}%produce(): functionCode
+// NOHANDLER-NOT: TryStartInst
+// NOHANDLER: function_end
diff --git a/test/shermes/integer-value-proofs.js b/test/shermes/integer-value-proofs.js
new file mode 100644
index 0000000000000000000000000000000000000000..a419b2737f4b3da13222a6fe8f3442a72288d7d4
--- /dev/null
+++ b/test/shermes/integer-value-proofs.js
@@ -0,0 +1,101 @@
+/**
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+// RUN: %shermes -O -fstatic-math-builtins -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fstatic-math-builtins -Xsmall-c -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O0 -exec %s | %FileCheck --match-full-lines %s
+// RUN: %hermes -O %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fstatic-math-builtins -emit-c -o %t.c %s
+// RUN: %FileCheck --check-prefix=C --input-file=%t.c %s
+
+function known(a, b) {
+  "noinline";
+  var x = Math.imul(+a, +b);
+  return (((x << 5) | (x >>> 27)) ^ (x >> 7)) >>> 0;
+}
+// C-LABEL: static SHLegacyValue _{{[0-9]+}}_known(SHRuntime *shr) {
+// C: _sh_ljs_imul_number(
+// C-NOT: _sh_to_uint32_double
+// C-NOT: _sh_to_int32_double
+// C-LABEL: static SHLegacyValue _{{[0-9]+}}_bounded(SHRuntime *shr) {
+
+function bounded(x, y, n) {
+  "noinline";
+  x = x | 0;
+  y = y >>> 0;
+  while (n-- > 0) {
+    x = Math.imul(((x << 13) | (x >>> 19)) ^ y, 0x85ebca6b);
+    y = (y + (x >>> 0)) >>> 0;
+  }
+  return [x, x >>> 0, y, y | 0];
+}
+// C: _sh_ljs_imul_uint32(
+// C: (uint32_t)(int32_t)_sh_ljs_get_double(
+// C-LABEL: static SHLegacyValue _{{[0-9]+}}_mixed(SHRuntime *shr) {
+
+function mixed(a, b, flag) {
+  "noinline";
+  var x = flag ? a | 0 : b >>> 0;
+  return Math.imul(x, 5) >>> 0;
+}
+// C: _sh_ljs_imul_uint32((uint32_t)(int64_t)_sh_ljs_get_double(
+
+function remainder(x, y) {
+  "noinline";
+  var r = +x % +y;
+  return [r, r | 0, r >>> 0, Math.imul(r, 5)];
+}
+function stringify(values) {
+  return values.map(x => Object.is(x, -0) ? '-0' : String(x)).join(' ');
+}
+print(stringify(remainder(3.9, 2)), stringify(remainder(-4, 2)));
+print(stringify(remainder(Infinity, 2)), stringify(remainder(4294967295, 1e20)));
+
