index 0000000000000000000000000000000000000000..16253d9094c832a19fdf136f8f47b9b2c8349019
--- /dev/null
+++ b/include/hermes/Optimizer/Scalar/RecordUseAnalysis.h
@@ -0,0 +1,154 @@
+/*
