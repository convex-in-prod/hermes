+globalThis.testNested = nested;
+assert(repeated({x: 1, y: 1, z: 1, w: 1}));
+assert(!repeated({x: 1, y: 1, z: 2, w: 1}));
+assert(repeated({}));
+assert(repeated(Object.create(null)));
+assert(nested({child: {x: 1, y: 2}}));
+
+var reads = 0;
+assert(nested({get child() { ++reads; gc(); return {x: 1, y: 2}; }}));
+assert(reads === 4);
+reads = 0;
+assert(repeated({
+  get x() { ++reads; gc(); return 1; }, y: 1, z: 1, w: 1,
+}));
+assert(reads === 4);
+reads = 0;
+var inherited = Object.create({get x() { ++reads; return 1; }});
+inherited.y = inherited.z = inherited.w = 1;
+assert(repeated(inherited));
+assert(reads === 4);
+
+var trace = [];
+var proxy = new Proxy({x: 1, y: 1, z: 1, w: 1}, {
+  get(target, key) { trace.push(key); gc(); return target[key]; },
+});
+assert(repeated(proxy));
+assert(trace.join(',') === 'x,y,x,z,x,w,x,y');
+var dictionary = {x: 1, y: 1, z: 1, w: 1};
+for (var i = 0; i < 80; ++i) dictionary['key' + i] = i;
+assert(repeated(dictionary));
+
+function interleaved(left, right) {
+  'noinline';
+  return left.x === 1 && right.x === 1 && left.x === 1 && left.x === 1;
+}
+globalThis.testInterleaved = interleaved;
+var left = {x: 1};
+assert(interleaved(left, {x: 1}));
+assert(!interleaved(left, {get x() { left.x = 2; gc(); return 1; }}));
+left.x = 1;
+assert(!interleaved(left, {get x() {
+  Object.defineProperty(left, 'x', {get: function () { return 2; }});
+  return 1;
+}}));
+
+function effects(record, effect) {
+  'noinline';
+  var first = record.x === 1 && record.x === 1 && record.x === 1;
+  effect(record);
+  return first && record.x === 2 && record.x === 2 && record.x === 2;
+}
+assert(effects({x: 1}, function (record) { record.x = 2; gc(); }));
+function writes(record, alias) {
+  'noinline';
+  var first = record.x;
+  alias.x = 2;
+  return first === 1 && record.x === 2 && record.x === 2 && record.x === 2;
+}
+left = {x: 1};
+assert(writes(left, left));
+
+function joined(left, right, skip) {
+  'noinline';
+  var first = left.x;
+  var condition = skip || right.x === 1;
+  return condition && left.x === first && left.x === first && left.x === first;
+}
+globalThis.testJoined = joined;
+assert(joined({x: 1}, {x: 1}, false));
+assert(joined({x: 1}, null, true));
+left = {x: 1};
+assert(!joined(left, {get x() { left.x = 2; gc(); return 1; }}, false));
+
+function coercion(record, value) {
+  'noinline';
+  var first = record.x === 1 && record.x === 1 && record.x === 1;
+  var number = value * 2;
+  return first && number === 4 && record.x === 2 && record.x === 2 && record.x === 2;
+}
+globalThis.testCoercion = coercion;
+left = {x: 1};
+assert(coercion(left, {valueOf: function () { left.x = 2; return 2; }}));
+
+function numeric(record, value) {
+  'noinline';
+  var first = record.x === 1 && record.x === 1 && record.x === 1;
+  var rounded = Math.round(value * 2);
+  return first && rounded === 4 && record.x === 1 && record.x === 1 && record.x === 1;
+}
+globalThis.testNumeric = numeric;
+assert(numeric({x: 1}, 2));
+left = {x: 1};
+assert(!numeric(left, {valueOf: function () { left.x = 2; gc(); return 2; }}));
+function mathCoercion(record, value) {
+  'noinline';
+  var first = record.x === 1 && record.x === 1 && record.x === 1;
+  var rounded = Math.round(value);
+  return first && rounded === 2 && record.x === 1 && record.x === 1 && record.x === 1;
+}
+globalThis.testMathCoercion = mathCoercion;
+assert(mathCoercion({x: 1}, 2));
+left = {x: 1};
+assert(!mathCoercion(left, {valueOf: function () { left.x = 2; return 2; }}));
+
+var oldConstructor = Object.getOwnPropertyDescriptor(Object.prototype, 'constructor');
+reads = 0;
+Object.defineProperty(Object.prototype, 'constructor', {
+  configurable: true,
+  get: function () { ++reads; return 1; },
+});
+function standardKeys(record) {
+  'noinline';
+  return record.constructor === 1 && record.constructor === 1 &&
+      record.constructor === 1;
+}
+assert(standardKeys({}));
+assert(reads === 3);
+Object.defineProperty(Object.prototype, 'constructor', oldConstructor);
+
+var sentinel = {};
+var caught;
+try {
+  repeated({get x() { throw sentinel; }});
+} catch (error) { caught = error; }
+assert(caught === sentinel);
+caught = undefined;
+try { repeated(null); } catch (error) { caught = error; }
+assert(caught instanceof TypeError);
+var revoked = Proxy.revocable({}, {});
+revoked.revoke();
+caught = undefined;
+try { repeated(revoked.proxy); } catch (error) { caught = error; }
+assert(caught instanceof TypeError);
+
+print('guarded record regions passed');
+// CHECK: guarded record regions passed
+
+// One receiver guard covers all four named fields; nested receivers need their
+// own proof. Generic getter paths retain the original read sequence.
+// IR-LABEL: function repeated(
+// IR: NativeCallInst {{.*}}extern_c(bool _sh_ljs_is_plain_record
+// IR: CondBranchInst
+// IR: PhiInst
+// IR: function_end
+// IR-LABEL: function nested(
+// IR: NativeCallInst {{.*}}extern_c(bool _sh_ljs_is_plain_record
+// IR: NativeCallInst {{.*}}extern_c(bool _sh_ljs_is_plain_record
+// IR: function_end
diff --git a/test/shermes/guarded-string-length.js b/test/shermes/guarded-string-length.js
new file mode 100644
index 0000000000000000000000000000000000000000..273a6f0d447ed9d6aa68147fd369ae9359251492
--- /dev/null
+++ b/test/shermes/guarded-string-length.js
@@ -0,0 +1,127 @@
+/**
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+// RUN: %shermes -O -verify-ir -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -Xsmall-c -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O0 -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -dump-lir -Xdump-functions=scan %s | %FileCheck --check-prefix=LIR %s
+
+function assert(value) {
+  if (!value) throw new Error('guarded string length semantics');
+}
+function scan(source, limit, effect) {
+  'noinline';
+  var count = 0;
+  for (var i = 0; i < limit; ++i) {
+    effect(i);
+    if (i >= source.length) break;
+    if (source[i] === 'x') ++count;
+  }
+  return count;
+}
+function collect() { gc(); }
+
+assert(scan('x\ud800x\udc00', 10, collect) === 2);
+assert(scan('', 10, collect) === 0);
+assert(scan(new String('xxx'), 10, collect) === 3);
+assert(scan(null, 0, collect) === 0);
+assert(scan(undefined, 0, collect) === 0);
+
+var trace = '';
+var reads = 0;
+var dynamic = {
+  get length() { trace += 'l'; gc(); return ++reads === 1 ? 2 : 1; },
+  get 0() { trace += 'c'; gc(); return 'x'; },
+};
+assert(scan(dynamic, 5, function () { trace += 'e'; }) === 1);
+assert(reads === 2 && trace === 'elcel');
+
+var values = ['x', 'x', 'x'];
+assert(scan(values, 5, function (i) {
+  if (i === 1) values.length = 1;
+  gc();
+}) === 1);
+values = ['x'];
+assert(scan(values, 3, function () { values.push('x'); gc(); }) === 3);
+
+var accesses = [];
+var proxy = new Proxy({0: 'x', 1: 'y', length: 2}, {
+  get(target, key) { accesses.push(key); gc(); return target[key]; },
+});
+assert(scan(proxy, 5, collect) === 1);
+assert(accesses.join(',') === 'length,0,length,1,length');
+var revoked = Proxy.revocable({}, {});
+revoked.revoke();
+assert(scan(revoked.proxy, 0, collect) === 0);
+
+var sentinel = {};
+var observed;
+trace = '';
+try {
+  scan({get length() { trace += 'l'; throw sentinel; }}, 1,
+       function () { trace += 'e'; });
+} catch (error) { observed = error; }
+assert(observed === sentinel && trace === 'el');
+observed = undefined;
+try {
+  scan(null, 1, function () { throw sentinel; });
+} catch (error) { observed = error; }
+assert(observed === sentinel);
+
+function reassigned(source) {
+  'noinline';
+  var change = function (value) { source = value; };
+  var count = 0;
+  for (var i = 0; i < 3; ++i) {
+    if (i === 1) change({length: 1});
+    if (i >= source.length) break;
+    if (source[i] === 'x') ++count;
+  }
+  return count;
+}
+assert(reassigned('xxx') === 1);
+
+function nested(source, repeats) {
+  'noinline';
+  var count = 0;
+  for (var round = 0; round < repeats; ++round)
+    for (var i = 0; i < source.length; ++i) {
+      if (source[i] === 'x') ++count;
+      gc();
+    }
+  return count;
+}
+assert(nested('x\ud800x', 3) === 6);
+assert(nested(null, 0) === 0);
+
+function changingInnerReceiver(sources) {
+  'noinline';
+  var count = 0;
+  for (var round = 0; round < sources.length; ++round) {
+    var source = sources[round];
+    for (var i = 0; i < source.length; ++i) {
+      if (source[i] === 'x') ++count;
+      gc();
+    }
+  }
+  return count;
+}
+assert(changingInnerReceiver(['xx', 'x', '', new String('xx'), ['x', 'y']]) === 6);
+print('guarded string length passed');
+// CHECK: guarded string length passed
+
+// The guard and cached length precede the callback. Its generic fallback still
+// reads at the original position, as the changing-getter case above requires.
+// LIR-LABEL: function scan(
+// LIR: %[[SOURCE:[0-9]+]] = LoadParamInst (:any) %source: any
+// LIR: %[[STRING:[0-9]+]] = TypeOfIsInst (:boolean) %[[SOURCE]]: any, typeOfIs(String)
+// LIR: CondBranchInst %[[STRING]]: boolean, %[[FAST:BB[0-9]+]], %{{BB[0-9]+}}
+// LIR: CallInst
+// LIR-NEXT: CondBranchInst %[[STRING]]: boolean,
+// LIR: %[[FAST]]:
+// LIR-NEXT: %{{[0-9]+}} = LoadPropertyInst (:number) %[[SOURCE]]: any, "length": string
+// LIR: function_end
