+var constructorReads = 0;
+var exact = Promise.resolve({value: 31});
+Object.defineProperty(exact, 'constructor', {get: function () {
+  ++constructorReads;
+  HermesInternal.drainJobs();
+  collect();
+  return Promise;
+}});
+async function nested() {
+  var value = await exact;
+  HermesInternal.drainJobs();
+  collect();
+  return value.value;
