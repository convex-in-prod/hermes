+      hasOwnNativeMethod(runtime, runtime.stringPrototype,
+                         Predefined::includes, stringPrototypeIncludesOrStartsWith) &&
+      hasOwnNativeMethod(runtime, runtime.arrayPrototype,
+                         Predefined::join, arrayPrototypeJoin);
