+// CHECK-NEXT: copied 8
+// CHECK-NEXT: copied 9
+// CHECK-NEXT: copied 10
+// CHECK-NEXT: copied 11
+// CHECK-NEXT: copied 12
+// CHECK-NEXT: copied 13
+// CHECK-NEXT: copied 14
+// CHECK-NEXT: copied 15
+// CHECK-NEXT: copied 16
+// CHECK-NEXT: copied 17
