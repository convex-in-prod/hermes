index 0000000000000000000000000000000000000000..8871aef3346c414f588aaeeede77639932587fb2
--- /dev/null
+++ b/test/shermes/native-async-driver.js
@@ -0,0 +1,108 @@
+/**
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+// RUN: %shermes -O -fasync-generator-results -exec -Wx,-Xnative-promise,-Xhermes-internal-test-methods %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fasync-generator-results -Xsmall-c -exec -Wx,-Xnative-promise,-Xhermes-internal-test-methods %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fasync-generator-results -exec -Wx,-Xhermes-internal-test-methods %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fasync-generator-results -emit-c -o %t.c %s
+// RUN: %FileCheck --check-prefix=LOWER %s < %t.c
+// LOWER: _sh_ljs_spawn_async_direct_from_frame(
+
+function check(value, message) {
+  if (!value) throw new Error(message);
+}
+function collect() {
+  if (typeof gc === 'function') gc();
+}
+
+var getterCalls = 0;
+var bad = Promise.resolve(0);
+var reason = {kind: 'constructor'};
+Object.defineProperty(bad, 'constructor', {get: function () {
+  ++getterCalls;
+  collect();
+  throw reason;
+}});
+var recovered = 0;
+async function failures() {
+  for (var i = 0; i < 1000; ++i) {
+    try {
+      await bad;
+      throw new Error('normalization unexpectedly succeeded');
+    } catch (error) {
+      check(error === reason, 'normalization error changed');
+      ++recovered;
+    }
+  }
+  return await 23;
+}
+var a = failures();
+check(getterCalls === 1000 && recovered === 1000,
+      'normalization failures did not resume synchronously');
+
+async function primitives() {
+  var values = [undefined, null, true, false, 0, -0, '', 17, 'text', NaN];
+  for (var i = 0; i < values.length; ++i) {
+    var value = await values[i];
+    collect();
+    check(Object.is(value, values[i]), 'await changed a primitive');
+  }
+  return 29;
+}
+
+var constructorReads = 0;
+var exact = Promise.resolve({value: 31});
+Object.defineProperty(exact, 'constructor', {get: function () {
+  ++constructorReads;
+  HermesInternal.drainJobs();
+  collect();
+  return Promise;
+}});
+async function nested() {
+  var value = await exact;
+  HermesInternal.drainJobs();
+  collect();
+  return value.value;
+}
+
+var finallyCalls = 0;
+async function cleanup() {
+  try {
+    await Promise.reject(reason);
+  } catch (error) {
+    check(error === reason, 'await rejection changed');
+    return 37;
+  } finally {
+    ++finallyCalls;
+    await undefined;
+    ++finallyCalls;
+  }
+}
+var parameterError = {kind: 'parameter'};
+async function parameters({value}) {
+  return value;
+}
+var input = {};
+Object.defineProperty(input, 'value', {get: function () { throw parameterError; }});
+var b = parameters(input).then(function () {
+  throw new Error('parameter error was lost');
+}, function (error) {
+  check(error === parameterError, 'parameter error escaped or changed');
+  return 41;
+});
+
+var finished = false;
+Promise.all([a, primitives(), nested(), cleanup(), b]).then(function (values) {
+  check(values.join(',') === '23,29,31,37,41', 'async completion changed');
+  check(constructorReads === 1, 'await repeated the constructor getter');
+  check(finallyCalls === 2, 'finally did not finish');
+  finished = true;
+});
+HermesInternal.drainJobs();
+check(finished, 'async work did not settle');
+print('native async driver semantics passed');
+// CHECK: native async driver semantics passed
diff --git a/test/shermes/native-integer-registers.js b/test/shermes/native-integer-registers.js
new file mode 100644
index 0000000000000000000000000000000000000000..0c54e536b873daf5a98933b1fbb79094508e03e4
--- /dev/null
+++ b/test/shermes/native-integer-registers.js
@@ -0,0 +1,130 @@
+/**
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+// RUN: %shermes -O -fnative-integer-registers -fstatic-math-builtins -verify-ir -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fnative-integer-registers -fstatic-math-builtins -Xsmall-c -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fstatic-math-builtins -exec %s | %FileCheck --match-full-lines %s
+// RUN: %shermes -O -fnative-integer-registers -fstatic-math-builtins -emit-c -o - %s | %FileCheck --check-prefix=C %s
+
+'use strict';
+function assert(value) {
+  if (!value) throw new Error('native integer storage semantics');
+}
+function mix(value, rounds) {
+  'noinline';
+  var word = value >>> 0;
+  for (var i = 0; i < rounds; ++i) {
+    word = Math.imul(word, 0xcc9e2d51);
+    word = ((word << 15) | (word >>> 17)) >>> 0;
+    word = Math.imul(word, 0x1b873593);
+    word = (word ^ (word >>> 16)) >>> 0;
+  }
+  return word;
+}
+globalThis.testMix = mix;
+function signed(value, shift) {
+  'noinline';
+  var a = value | 0;
+  var b = shift | 0;
+  var c = (a << b) ^ (a >> b);
+  return c | 0;
+}
+globalThis.testSigned = signed;
+function swap(left, right, rounds) {
+  'noinline';
+  left = left | 0;
+  right = right | 0;
+  for (var i = 0; i < rounds; ++i) {
+    var old = left;
+    left = right;
+    right = old;
+  }
+  return [left, right];
+}
+globalThis.testSwap = swap;
+function negativeZero(choose) {
+  'noinline';
+  var value = choose ? -0 : 0;
+  return 1 / value;
+}
+globalThis.testNegativeZero = negativeZero;
+function dynamicMultiply(left, right) {
+  'noinline';
+  return Math.imul(left, right) >>> 0;
+}
+globalThis.testDynamicMultiply = dynamicMultiply;
+function captured(value) {
+  'noinline';
+  var word = value >>> 0;
+  return function () { gc(); return word; };
+}
+globalThis.testCaptured = captured;
+function mixedPhi(value, choose) {
+  'noinline';
+  var word = value | 0;
+  if (choose) word = -0;
+  return word;
+}
+globalThis.testMixedPhi = mixedPhi;
+assert(negativeZero(true) === -Infinity);
+assert(negativeZero(false) === Infinity);
+assert(Object.is(mixedPhi(3, true), -0));
+assert(mixedPhi(3, false) === 3);
