+bool isStandardObjectPrototypeKey(Identifier key) {
+  return llvh::StringSwitch<bool>(key.str())
+      .Cases("constructor", "toString", "toLocaleString", true)
+      .Cases("valueOf", "hasOwnProperty", "isPrototypeOf", true)
+      .Cases("propertyIsEnumerable", "__proto__", true)
+      .Cases("__defineGetter__", "__defineSetter__", true)
+      .Cases("__lookupGetter__", "__lookupSetter__", true)
+      .Default(false);
+}
