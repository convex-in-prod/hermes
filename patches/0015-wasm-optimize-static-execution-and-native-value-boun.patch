+// CHECK-NEXT: {"start":0,"x":9,"y":3}
+// CHECK-NEXT: {"start":0,"x":11} 1
+// CHECK-NEXT: 13 1
+// CHECK-NEXT: {"x":17} kdg
+// CHECK-NEXT: {"a":1,"b":2} true
+// CHECK-NEXT: [{"base":1,"tail":2},{"base":1,"item":1,"tail":2},{"base":1,"tail":2},{"base":1,"item":3,"tail":2}]
+// CHECK-NEXT: [{"base":1,"item":1},{"base":2,"item":2}] 1
