+static inline SHLegacyValue _sh_ljs_get_by_val_cached_rjs_inline(
+    SHRuntime *shr,
+    SHLegacyValue *source,
+    SHLegacyValue *key,
+    SHComputedReadCacheEntry *cache) {
+  SHLegacyValue result;
+  if (_sh_try_get_indexed_element(shr, *source, key->f64, &result))
+    return result;
