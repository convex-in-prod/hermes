+
+var reads = 0;
+for (var key of ['1', '-1', '0.5', 'NaN', 'Infinity', '4294967296']) {
+  Object.defineProperty(String.prototype, key, {
+    configurable: true,
+    get() { ++reads; gc(); return 'x'; },
+  });
+}
+print(equal('a', 1), equal('a', -1), equal('a', 0.5), equal('a', NaN),
+      equal('a', Infinity), equal('a', 4294967296), reads);
