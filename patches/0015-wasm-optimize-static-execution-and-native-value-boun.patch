+  function aliased(fn) {
+    'noinline';
+    arguments[0] = function () { return 2; };
+    return fn();
+  }
+  if (aliased(function () { return 1; }) !== 1)
+    throw new Error('aliased callback contract');
+  print('aliased callbacks passed');
+})();
