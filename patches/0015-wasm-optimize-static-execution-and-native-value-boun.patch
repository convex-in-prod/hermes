+              case BuiltinMethod::Math_ceil:
+              case BuiltinMethod::Math_floor:
+              case BuiltinMethod::Math_round:
+              case BuiltinMethod::Math_trunc:
+              case BuiltinMethod::Math_min:
+              case BuiltinMethod::Math_max:
