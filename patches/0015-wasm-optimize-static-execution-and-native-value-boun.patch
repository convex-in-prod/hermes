+  Value *lowerAsyncFrameArguments(CallInst *call) {
+    if (!optimize_ ||
+        !F_->getContext().getOptimizationSettings().asyncFrameArguments ||
+        !llvh::isa<AsyncFunction>(F_) || call->getNumArguments() != 4 ||
+        !llvh::isa<LiteralUndefined>(call->getNewTarget()))
