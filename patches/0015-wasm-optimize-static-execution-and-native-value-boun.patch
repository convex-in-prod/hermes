  private:
+  bool reuseAsyncGeneratorResults(CreateFunctionInst *generator) {
+    if (!F_->getContext().getOptimizationSettings().asyncGeneratorResults ||
+        !generator->hasOneUser() ||
+        !generator->getFunctionCode()->hasOneUser())
+      return false;
