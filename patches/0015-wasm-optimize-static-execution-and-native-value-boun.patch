+jsi::Object HermesRuntimeImpl::createObjectWithProperties(
+    const std::vector<std::pair<std::string, jsi::Value>> &properties) {
+  ExecutionScopeRAII scopeRAII(mutatorScope);
+  vm::GCScope gcScope(runtime_);
+  // Bound retained key bytes and slots independently of application schemas.
+  bool cacheable = properties.size() <= 128;
+  std::string shapeKey;
+  for (const auto &property : properties) {
+    const auto &key = property.first;
+    if (shapeKey.size() + key.size() + 12 > 8192 ||
+        (!key.empty() && key[0] >= '0' && key[0] <= '9')) {
+      cacheable = false;
+      break;
+    }
+    shapeKey += std::to_string(key.size());
+    shapeKey += ':';
+    shapeKey += key;
+  }
+  auto cached = cacheable ? objectShapeCache_.find(shapeKey)
+                          : objectShapeCache_.end();
+  if (cached != objectShapeCache_.end()) {
+    auto clazz = runtime_.makeHandle(handle(cached->second)->getClassGCPtr());
+    auto result = runtime_.makeHandle(vm::JSObject::create(
+        runtime_, vm::Handle<vm::JSObject>::vmcast(&runtime_.objectPrototype),
+        clazz));
+    for (size_t i = 0; i < properties.size(); ++i) {
+      auto value = vm::SmallHermesValue::encodeHermesValue(
+          hvFromValue(properties[i].second), runtime_);
+      vm::JSObject::setNamedSlotValueUnsafe(*result, runtime_, i, value);
+    }
+    return add<jsi::Object>(result.getHermesValue());
+  }
+
+  auto result = runtime_.makeHandle(vm::JSObject::create(runtime_));
+  auto marker = gcScope.createMarker();
+  for (const auto &property : properties) {
+    gcScope.flushToMarker(marker);
+    auto key = createStringFromUtf8(
+        reinterpret_cast<const uint8_t *>(property.first.data()),
+        property.first.size());
+    vm::DefinePropertyFlags flags{};
+    flags.setValue = flags.setWritable = flags.setEnumerable =
+        flags.setConfigurable = true;
+    flags.writable = flags.enumerable = flags.configurable = true;
+    auto status = vm::JSObject::defineOwnComputedPrimitive(
+        result, runtime_, stringHandle(key), flags,
+        runtime_.makeHandle(hvFromValue(property.second)),
+        vm::PropOpFlags().plusThrowOnError());
+    checkStatus(status.getStatus());
+  }
+  auto clazz = runtime_.makeHandle(result->getClassGCPtr());
+  // Indexed keys, duplicates and mutable dictionary classes use the normal
+  // definition path. Sharing a dictionary class would corrupt other objects.
+  if (cacheable && !clazz->isDictionary() &&
+      clazz->getNumProperties() == properties.size()) {
+    auto shape = runtime_.makeHandle(vm::JSObject::create(
+        runtime_, vm::Handle<vm::JSObject>::vmcast(&runtime_.objectPrototype),
+        clazz));
+    for (size_t i = 0; i < properties.size(); ++i)
+      vm::JSObject::setNamedSlotValueUnsafe(
+          *shape, runtime_, i, vm::SmallHermesValue::encodeUndefinedValue());
+    if (objectShapeCache_.size() == 64)
+      objectShapeCache_.clear();
+    objectShapeCache_.emplace(std::move(shapeKey),
+                             add<jsi::Object>(shape.getHermesValue()));
+  }
+  return add<jsi::Object>(result.getHermesValue());
+}
+
+jsi::Array HermesRuntimeImpl::createArrayWithValues(
+    const std::vector<jsi::Value> &values) {
+  ExecutionScopeRAII scopeRAII(mutatorScope);
+  vm::GCScope gcScope(runtime_);
+  auto created = vm::JSArray::create(runtime_, values.size(), values.size());
+  checkStatus(created.getStatus());
+  auto result = runtime_.makeHandle(std::move(*created));
+  for (size_t i = 0; i < values.size(); ++i) {
+    auto value = vm::SmallHermesValue::encodeHermesValue(
+        hvFromValue(values[i]), runtime_);
+    vm::JSArray::unsafeSetExistingElementAt(*result, runtime_, i, value);
+  }
+  return add<jsi::Array>(result.getHermesValue());
+}
