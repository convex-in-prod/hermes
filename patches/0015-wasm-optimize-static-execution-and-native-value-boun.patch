+TEST_F(StringPrimTest, FullSliceRetainsPrimitive) {
+  for (auto input : {u"", u"a", u"unchanged", u"\u03b1\u03b2\u03b3"}) {
+    auto str = StringPrimitive::createNoThrow(runtime, createUTF16Ref(input));
