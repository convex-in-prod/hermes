+TEST(UnicodeTest, CanonicalizationEveryCodePoint) {
+  for (bool unicode : {false, true}) {
+    std::vector<uint32_t> expected(UNICODE_MAX_VALUE + 1);
+    std::iota(expected.begin(), expected.end(), 0);
