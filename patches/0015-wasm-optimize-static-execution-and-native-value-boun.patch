+// CHECK: ["a","b"] ["a","a"]
+print(JSON.stringify(scanOwned('a:*')), JSON.stringify(scanImpure('ab')), scanEffects);
+// CHECK: ["a",{"options":["*"]}] ["a","b"] 2
+
