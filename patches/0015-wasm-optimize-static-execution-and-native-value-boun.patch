+var getterCalls = 0;
+Object.defineProperty(object, 'alpha', {get() { ++getterCalls; return 11; }});
+assert(read(object, 'alpha') === 11 && getterCalls === 1);
+delete object.beta;
+Object.setPrototypeOf(object, {beta: 12});
