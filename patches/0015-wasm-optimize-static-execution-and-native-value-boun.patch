+Pass *hermes::createRecordArgumentPromotion() {
+  class RecordArguments final : public ModulePass {
+   public:
+    RecordArguments() : ModulePass("RecordArgumentPromotion") {}
+    bool runOnModule(Module *M) override {
+      bool changed = false;
+      for (auto &F : *M) {
