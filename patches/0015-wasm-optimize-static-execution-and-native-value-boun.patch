+  ownKeys(target) { traps += 'k'; return Reflect.ownKeys(target); },
+  getOwnPropertyDescriptor(target, key) { traps += 'd'; return Reflect.getOwnPropertyDescriptor(target, key); },
+  get(target, key) { traps += 'g'; return target[key]; }
+});
