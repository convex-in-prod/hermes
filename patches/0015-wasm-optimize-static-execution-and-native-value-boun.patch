+function read(object) {
+  'noinline';
+  return object.value;
+}
+function check(actual, expected) {
+  if (actual !== expected) throw new Error('named read contract');
+}
+var first = {value: 1};
+var second = {before: 2, value: 3};
+for (var i = 0; i < 20; ++i) {
+  check(read(first), 1);
+  check(read(second), 3);
+  gc();
