+// C: _sh_ljs_imul_number(
+// C-NOT: _sh_to_uint32_double
+// C-NOT: _sh_to_int32_double
+// C-LABEL: static SHLegacyValue _{{[0-9]+}}_bounded(SHRuntime *shr) {
+
+function bounded(x, y, n) {
+  "noinline";
+  x = x | 0;
+  y = y >>> 0;
+  while (n-- > 0) {
+    x = Math.imul(((x << 13) | (x >>> 19)) ^ y, 0x85ebca6b);
+    y = (y + (x >>> 0)) >>> 0;
+  }
+  return [x, x >>> 0, y, y | 0];
+}
