+function equal(source, index) {
+  "noinline";
+  var text = '' + source;
+  return text[+index] === 'x';
+}
+function different(source, index) {
+  "noinline";
+  var text = '' + source;
+  return 'x' !== text[+index];
+}
+function surrogate(source, index) {
+  "noinline";
+  var text = '' + source;
+  return text[+index] === '\uD800';
+}
+function nul(source, index) {
+  "noinline";
+  var text = '' + source;
+  return text[+index] === '\0';
+}
+print(equal('xy', 0), equal('xy', -0), equal('xy', 1), different('xy', 0));
