+// CHECK-NEXT: true si
+
+function arbitrary(source, key) {
+  "noinline";
+  return source[key] === 'x';
+}
+print(arbitrary(['x'], 0), arbitrary({get a() { gc(); return 'x'; }}, 'a'));
+// CHECK-NEXT: true true
+try { arbitrary(null, 0); } catch (e) { print(e.name); }
+// CHECK-NEXT: TypeError
+
+function dynamic(source, index) {
+  "noinline";
