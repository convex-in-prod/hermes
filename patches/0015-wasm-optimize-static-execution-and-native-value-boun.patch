+  },
+};
+assert(!contains(arrayLike, 'b'));
+assert(trace.join(',') === 'length,coerce');
+trace = [];
+var proxy = new Proxy([1, 2], {
+  get: function (target, key) { trace.push('get:' + key); return target[key]; },
