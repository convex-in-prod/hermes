+  bool lowerStringTrimComparison(BinaryOperatorInst *comparison) {
+    if (!F_->getContext().getOptimizationSettings().stringTrimComparisons)
+      return false;
+    auto *call = llvh::dyn_cast<CallInst>(comparison->getLeftHandSide());
