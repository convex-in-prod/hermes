+    function malloc(size: c_size_t): c_ptr { throw 0; });
+const free = $SHBuiltin.extern_c({include: "stdlib.h"},
+    function free(pointer: c_ptr): void {});
+const readByte = $SHBuiltin.extern_c({declared: true},
