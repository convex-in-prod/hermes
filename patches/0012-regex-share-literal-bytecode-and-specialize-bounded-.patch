+  os << "  } else {\n    const uint16_t *s = (const uint16_t *)input;\n";
+  emitBody(os, ops, anchored, "16");
+  os << "  }\n}\n";
+  os.flush();
+  if (source.size() > kMaxSource)
+    return llvh::None;
+  return source;
+}
