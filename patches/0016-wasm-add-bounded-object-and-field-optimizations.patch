+Pass *createGuardedRecordLoadDedup() {
+  class ThisPass : public FunctionPass {
+   public:
+    ThisPass() : FunctionPass("GuardedRecordLoadDedup") {}
+    bool runOnFunction(Function *F) override {
+      return run(F);
+    }
+  };
+  return new ThisPass();
+}
