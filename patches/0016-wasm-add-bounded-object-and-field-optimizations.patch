+void HermesRuntimeImpl::markObjectLayoutUsed(ObjectLayout &layout) {
+  // Consecutive reuse needs no list maintenance. An evicted layout may still
+  // serve a construction whose key callback evicted it, but must not rejoin.
+  if (!layout.cached || &layout == newestObjectLayout_)
+    return;
+  if (layout.older)
+    layout.older->newer = layout.newer;
+  else
+    oldestObjectLayout_ = layout.newer;
+  assert(layout.newer && "Only the newest cached layout has no successor");
+  layout.newer->older = layout.older;
+  layout.older = newestObjectLayout_;
+  layout.newer = nullptr;
+  newestObjectLayout_->newer = &layout;
+  newestObjectLayout_ = &layout;
+}
