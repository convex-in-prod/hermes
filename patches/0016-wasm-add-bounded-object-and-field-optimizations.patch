+  if (!callback || !llvh::isa<NormalFunction>(callback->getFunctionCode()))
+    return false;
+  unsigned instructions = 0;
+  for (auto &block : *callback->getFunctionCode())
+    for (auto &inst : block) {
+      (void)inst;
+      if (++instructions > 128)
