+def print_case_mappings():
+    """Generate full, locale-independent casing, separately from RegExp folding."""
+    files = ("UnicodeData.txt", "SpecialCasing.txt", "DerivedCoreProperties.txt")
+    print("// Generated by genUnicodeTable.py --case-mapping. Do not edit.")
+    print(f"// Unicode version {UnicodeDataFiles.VERSION}.")
+    for filename in files:
+        print(f"// {filename}: SHA1 {UnicodeDataFiles.get_sha1(filename)}")
+
+    mappings = {"LOWER": {}, "UPPER": {}}
+    for line in UnicodeDataFiles.get_lines("UnicodeData.txt"):
+        fields = line.split(";")
+        cp = int(fields[CODEPOINT_FIELD], 16)
+        for name, field in (("LOWER", LOWERCASE_FIELD), ("UPPER", UPPERCASE_FIELD)):
+            if fields[field]:
+                mappings[name][cp] = [int(fields[field], 16)]
+    for line in UnicodeDataFiles.get_lines("SpecialCasing.txt"):
+        fields = [field.strip() for field in line.split("#")[0].split(";")]
+        if len(fields) < 5:
+            continue
+        cp, lower, _, upper, condition = fields[:5]
+        if condition:
+            # Final_Sigma is applied to the original string by Unicode-Lite.
+            # All other conditional rules select an explicit locale.
+            if condition != "Final_Sigma" and condition.split()[0] not in {
+                "tr",
+                "az",
+                "lt",
+            }:
+                raise ValueError(f"Unsupported casing condition: {condition}")
+            continue
+        for name, value in (("LOWER", lower), ("UPPER", upper)):
+            mappings[name][int(cp, 16)] = [int(value, 16) for value in value.split()]
+
+    for name, mapping in mappings.items():
+        blocks = []
+        expansions = []
+        for cp, mapped in sorted(mapping.items()):
+            if len(mapped) == 1:
+                if mapped[0] != cp:
+                    DeltaMapBlock.append_to_list(blocks, (cp, mapped[0]))
+            else:
+                if not 1 < len(mapped) <= 3:
+                    raise ValueError("Unicode case mapping exceeds three code points")
+                expansions.append((cp, mapped))
+        print(f"static constexpr CaseMappingRange {name}_MAPPINGS[] = {{")
+        for block in blocks:
+            print(block.output() + ",")
+        print("};")
+        print(f"static constexpr CaseMappingExpansion {name}_EXPANSIONS[] = {{")
+        for cp, mapped in expansions:
+            values = ", ".join(as_hex(value) for value in mapped)
+            print(f"{{{as_hex(cp)}, {len(mapped)}, {{{values}}}}},")
+        print("};")
+
+    for prop in ("Cased", "Case_Ignorable"):
+        ranges = []
+        for line in UnicodeDataFiles.get_lines("DerivedCoreProperties.txt"):
+            fields = [field.strip() for field in line.split("#")[0].split(";")]
+            if len(fields) >= 2 and fields[1] == prop:
+                ranges.append(parse_range(fields[0]))
+        merged = []
+        for start, end in sorted(ranges):
+            if merged and start <= merged[-1][1] + 1:
+                merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
+            else:
+                merged.append((start, end))
+        print(f"static constexpr CasePropertyRange {prop.upper()}[] = {{")
+        for start, end in merged:
+            print(f"{{{as_hex(start)}, {as_hex(end)}}},")
+        print("};")
+
