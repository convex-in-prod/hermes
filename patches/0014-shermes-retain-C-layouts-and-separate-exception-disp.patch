+
+compiler = pathlib.Path(sys.argv[1]).resolve()
+root = pathlib.Path(sys.argv[2]).resolve()
+root.mkdir(parents=True, exist_ok=True)
+assert len(sys.argv) in (3, 8)
+native = sys.argv[3:]
+compile_count = 0
+execute_count = 0
+source = '''
+function read(value) {
+  "noinline";
+  return value.stableProperty;
+}
+print(read({stableProperty: "kept"}));
+print("\\ud800");
